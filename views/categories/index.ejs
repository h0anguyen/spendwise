<div class="flex-between mb-6">
  <h2 style="font-size:18px;font-weight:800">Danh Mục</h2>
</div>
<div class="grid-2">
  <div class="card">
    <div class="card-header"><span class="card-title"><i data-lucide="plus"></i> Thêm Danh Mục</span></div>
    <div class="card-body">
      <form action="/categories" method="POST">
        <div class="form-group">
          <label class="form-label">Tên danh mục *</label>
          <input type="text" name="name" class="form-control" placeholder="VD: Ăn uống" required/>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Biểu tượng</label>
            <div style="display:flex; gap:10px; align-items:center;">
              <button type="button" id="emojiPreview" class="emoji-preview-btn" onclick="openEmojiPicker('catIconInput', 'emojiPreview')">🍜</button>
              <input type="hidden" name="icon" id="catIconInput" value="🍜"/>
              <span class="text-muted text-xs">Click để chọn</span>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Màu sắc</label>
            <input type="color" name="color" class="form-control" value="#6366f1" style="height:46px; padding:4px; cursor:pointer;"/>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Loại</label>
          <select name="type" class="form-control">
            <option value="expense">Chi tiêu</option>
            <option value="income">Thu nhập</option>
            <option value="both">Cả hai</option>
          </select>
        </div>
        <button type="submit" class="btn-primary w-full"><i data-lucide="plus"></i> Thêm Danh Mục</button>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span class="card-title"><i data-lucide="tags"></i> Danh Sách (<%= categories.length %>)</span></div>
    <div class="card-body" style="padding:0">
      <% if(categories.length===0){ %>
      <div class="empty-state"><i data-lucide="tags"></i><h3>Chưa có danh mục</h3></div>
      <% } else { %>
      <div style="padding:12px; display:flex; flex-direction:column; gap:8px;">
        <% categories.forEach(function(cat){ %>
        <div style="display:flex;align-items:center;gap:12px;padding:12px;border-radius:14px;background:var(--bg-2);border:1px solid var(--border);transition:all 0.2s;" class="category-item-hover">
          <div style="width:42px;height:42px;border-radius:12px;background:<%= cat.color %>22;display:flex;align-items:center;justify-content:center;font-size:20px; border:1px solid <%= cat.color %>44;"><%= cat.icon %></div>
          <div style="flex:1">
            <div style="font-weight:600;font-size:14px; color:var(--text);"><%= cat.name %></div>
            <div style="font-size:11px;color:var(--text-3); font-weight:500;"><%= ({expense:'CHI TIÊU',income:'THU NHẬP',both:'CẢ HAI'})[cat.type] %></div>
          </div>
          <div style="width:12px;height:12px;border-radius:4px;background:<%= cat.color %>; box-shadow: 0 0 10px <%= cat.color %>66;"></div>
          <% if(!cat.isDefault && cat.user){ %>
          <button class="btn-danger btn-sm" style="padding:6px 10px; border-radius:10px;"
            hx-delete="/categories/<%= cat._id %>" 
            hx-target="closest .category-item-hover" 
            hx-swap="outerHTML swap:400ms" 
            hx-confirm="Bạn có chắc chắn muốn xóa danh mục này?">
            <i data-lucide="trash-2" style="width:14px;height:14px"></i>
          </button>
          <% } %>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<style>
  .category-item-hover:hover { border-color: var(--brand); transform: translateX(5px); background: var(--bg-3); }
</style>
