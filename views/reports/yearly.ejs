<div class="flex-between mb-6">
  <h2 style="font-size:18px;font-weight:800">Báo Cáo Năm <%= selectedYear %></h2>
  <div style="display:flex;gap:10px">
    <form method="GET" style="display:flex;gap:8px">
      <select name="year" class="form-control" style="width:auto">
        <% for(let y=new Date().getFullYear();y>=2020;y--){ %><option value="<%= y %>" <%= y===selectedYear?'selected':'' %>><%= y %></option><% } %>
      </select>
      <button type="submit" class="btn-primary">Xem</button>
    </form>
    <a href="/reports/export?startDate=<%= selectedYear %>-01-01&endDate=<%= selectedYear %>-12-31" class="btn-secondary"><i class="fa fa-download"></i> Xuất CSV</a>
  </div>
</div>

<div class="stats-grid mb-6">
  <div class="stat-card" style="--accent-color:#ef4444"><div class="stat-header"><span class="stat-label">Tổng Chi Tiêu Năm</span></div><div class="stat-value negative"><%= (totalExpense/1000000).toFixed(1) %>M</div></div>
  <div class="stat-card" style="--accent-color:#22c55e"><div class="stat-header"><span class="stat-label">Tổng Thu Nhập Năm</span></div><div class="stat-value positive"><%= (totalIncome/1000000).toFixed(1) %>M</div></div>
  <div class="stat-card" style="--accent-color:#6366f1"><div class="stat-header"><span class="stat-label">Tiết Kiệm</span></div><div class="stat-value"><%= ((totalIncome-totalExpense)/1000000).toFixed(1) %>M</div></div>
</div>

<div class="card mb-6"><div class="card-header"><span class="card-title"><i class="fa fa-chart-bar"></i> Chi Tiêu & Thu Nhập Theo Tháng</span></div>
  <div class="card-body"><div style="height:280px"><canvas id="yearlyChart" role="img" aria-label="Biểu đồ năm"></canvas></div></div>
</div>

<div class="grid-2">
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa fa-chart-pie"></i> Phân Bổ Chi Tiêu</span></div>
    <div class="card-body">
      <% if(categoryBreakdown.length===0){ %><div class="empty-state" style="padding:32px"><i class="fa fa-chart-pie"></i><h3>Chưa có dữ liệu</h3></div>
      <% } else { %>
      <div style="display:flex;gap:16px;align-items:center">
        <div style="width:140px;height:140px;flex-shrink:0"><canvas id="catChart" role="img" aria-label="Phân bổ danh mục năm"></canvas></div>
        <div style="flex:1">
          <% categoryBreakdown.slice(0,6).forEach(function(c){ %>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;font-size:12px">
            <div style="width:8px;height:8px;border-radius:2px;background:<%= c.categoryInfo.color %>"></div>
            <span style="flex:1;color:var(--text-2)"><%= c.categoryInfo.name %></span>
            <span style="font-weight:700"><%= (c.total/1000000).toFixed(1) %>M</span>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
  <div class="card"><div class="card-header"><span class="card-title"><i class="fa fa-table-list"></i> Bảng Tổng Hợp</span></div>
    <div class="card-body" style="padding:0">
      <table><thead><tr><th>Tháng</th><th class="text-right">Chi tiêu</th><th class="text-right">Thu nhập</th><th class="text-right">Số dư</th></tr></thead>
      <tbody>
      <% const mNames=['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6','Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12']; %>
      <% months.forEach(function(m,i){ %>
      <tr>
        <td style="font-weight:600"><%= mNames[i] %></td>
        <td class="text-right"><span class="amount amount-expense">-<%= (m.expense/1000000).toFixed(2) %>M</span></td>
        <td class="text-right"><span class="amount amount-income">+<%= (m.income/1000000).toFixed(2) %>M</span></td>
        <td class="text-right"><span class="amount <%= (m.income-m.expense)>=0?'amount-income':'amount-expense' %>"><%= ((m.income-m.expense)/1000000).toFixed(2) %>M</span></td>
      </tr>
      <% }) %>
      </tbody></table>
    </div>
  </div>
</div>

<script>
(function() {
  const months = <%- JSON.stringify(months) %>;
  const cats = <%- JSON.stringify(categoryBreakdown) %>;
  const mLabels=['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'];
  new Chart(document.getElementById('yearlyChart'),{type:'bar',data:{labels:mLabels,datasets:[{label:'Chi tiêu',data:months.map(m=>m.expense),backgroundColor:'rgba(239,68,68,.7)',borderRadius:4},{label:'Thu nhập',data:months.map(m=>m.income),backgroundColor:'rgba(34,197,94,.7)',borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:'#44445a'},grid:{display:false},border:{display:false}},y:{ticks:{color:'#44445a',callback:v=>v>=1e6?(v/1e6).toFixed(1)+'M':v},grid:{color:'rgba(255,255,255,0.04)'},border:{display:false}}}}});
  if(cats.length>0) new Chart(document.getElementById('catChart'),{type:'doughnut',data:{labels:cats.map(c=>c.categoryInfo.name),datasets:[{data:cats.map(c=>c.total),backgroundColor:cats.map(c=>c.categoryInfo.color),borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{display:false}}}});
})();
</script>
