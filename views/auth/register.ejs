<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng Ký — SpendWise</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<div class="auth-page">
  <div class="auth-card fade-in">
    <div class="auth-logo">
      <svg class="brand-icon" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="10" fill="url(#g2)"/><path d="M8 22L13 15L17 19L22 12" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="22" cy="12" r="2.5" fill="white"/><defs><linearGradient id="g2" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
      <h1 class="auth-title">Tạo tài khoản</h1>
      <p class="auth-subtitle">Bắt đầu theo dõi chi tiêu của bạn ngay hôm nay</p>
    </div>

    <% if (error && error.length > 0) { %>
    <div class="alert alert-error" style="margin-bottom:16px;">
      <i class="fa fa-triangle-exclamation"></i><span><%= error[0] %></span>
    </div>
    <% } %>

    <form action="/auth/register" method="POST">
      <div class="form-group">
        <label class="form-label">Họ và tên</label>
        <input type="text" name="name" class="form-control" placeholder="Nguyễn Văn A" required autocomplete="name" />
      </div>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="name@example.com" required autocomplete="email" />
      </div>
      <div class="form-group">
        <label class="form-label">Mật khẩu (ít nhất 8 ký tự)</label>
        <div style="position:relative;">
          <input type="password" name="password" id="passwordInput" class="form-control" placeholder="••••••••" required minlength="8" style="padding-right:40px;" />
          <button type="button" onclick="togglePwd()" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-3);cursor:pointer;"><i class="fa fa-eye" id="eyeIcon"></i></button>
        </div>
      </div>
      <button type="submit" class="btn-primary w-full" style="margin-top:8px;">
        <i class="fa fa-user-plus"></i> Đăng Ký
      </button>
    </form>

    <div class="auth-footer">
      Đã có tài khoản? <a href="/auth/login">Đăng nhập</a>
    </div>
  </div>
</div>
<script>
  const saved = localStorage.getItem('sw-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  function togglePwd() {
    const inp = document.getElementById('passwordInput');
    const ic = document.getElementById('eyeIcon');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    ic.className = inp.type === 'password' ? 'fa fa-eye' : 'fa fa-eye-slash';
  }
</script>
</body>
</html>
