# ================================
# APP CONFIGURATION
# ================================
NODE_ENV=development
PORT=3000
APP_NAME=ExpenseTracker
APP_URL=http://localhost:3000

# ================================
# DATABASE
# ================================
MONGODB_URI=mongodb://localhost:27017/expense_tracker
MONGODB_URI_TEST=mongodb://localhost:27017/expense_tracker_test

# ================================
# SESSION & JWT
# ================================
SESSION_SECRET=your_super_secret_session_key_change_in_production_min_32_chars
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
SESSION_MAX_AGE=604800000

# ================================
# SECURITY
# ================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ================================
# LOGGING
# ================================
LOG_LEVEL=info
LOG_DIR=./logs

# ================================
# EMAIL (Optional - for reports)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@expensetracker.com

# ================================
# UPLOAD
# ================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# ================================
# ENCRYPTION (Field-Level)
# ================================
ENCRYPTION_KEY=your_64_char_hex_key_generate_with_node_crypto_randomBytes_32
